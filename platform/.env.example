# Central authentication service
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3200
LOCAL_BETTER_AUTH_URL=http://127.0.0.1:3200
PORTAL_SESSION_SECRET=replace-with-at-least-32-different-random-characters
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
AUTH_DATABASE_SCHEMA=aura_identity_local
AURA_CLIENT_PROFILE=local
DEMO_PERSONA_PASSWORD=replace-with-private-random-password
# Optional JSON map of additional HTTPS portal origins for alternate deployments.
AURA_PORTAL_ORIGINS_JSON={}

# Public PKCE client IDs are provisioned from the checked-in portal contract.
# No per-portal OIDC client secret is used.

# Private institutional core
CORE_DATABASE_SCHEMA=aura_core_local
CORE_API_URL=http://127.0.0.1:3300
CORE_API_AUDIENCE=urn:aura:core-api
CORE_OIDC_ISSUER=http://127.0.0.1:3200/api/auth
CORE_OIDC_JWKS_URL=http://127.0.0.1:3200/api/auth/jwks
CORE_RESET_CONFIRMATION=AURA-SYNTHETIC-SEED-V1

# Chapter 11 bounded model adapter, configured on Core only.
# Every review and plan runs on AI. With no model configured (no GROQ_API_KEY and blank values here), a
# review waits as "AI unavailable, retry" instead of producing a rule-based draft. Chain: Groq, Gemini, local Qwen.
CH11_MODEL=
CH11_MODEL_BASE_URL=
CH11_MODEL_API_KEY=
# Provider order (server configuration only). Default: Groq, then Gemini, then the local Qwen model on the laptop.
# CH11_PROVIDER_ORDER=groq,gemini,configured,local
# Local example for an already installed Ollama model:
# CH11_MODEL=qwen3.8:27b-mlx
# CH11_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# Hosted deployments require a reachable HTTPS endpoint and its private key.

# Real college activation is opt-in and needs verified identities/source mappings.
# Keep its schemas separate from all demonstration schemas. See REAL_COLLEGE_ROLLOUT.md.
AURA_IDENTITY_MODE=demo
AURA_PORTAL_MODE=demo
CORE_IDENTITY_REALM=demo
# COLLEGE_ACTIVE_PACKAGE_HASH=<approved immutable source/access package digest>
# COLLEGE_NORMALIZATION_BATCH_HASH=<approved linked measurement batch digest>
