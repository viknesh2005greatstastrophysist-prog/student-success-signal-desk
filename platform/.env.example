# Central authentication service
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3200
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
AUTH_DATABASE_SCHEMA=aura_identity
DEMO_ACCESS_PIN=replace-with-private-demo-pin
DEMO_PERSONA_PASSWORD=replace-with-private-random-password

# Portal OIDC clients. Values are produced by the auth client seed command.
STUDENT_OIDC_CLIENT_ID=
STUDENT_OIDC_CLIENT_SECRET=
PARENT_OIDC_CLIENT_ID=
PARENT_OIDC_CLIENT_SECRET=
FACULTY_OIDC_CLIENT_ID=
FACULTY_OIDC_CLIENT_SECRET=
HOD_OIDC_CLIENT_ID=
HOD_OIDC_CLIENT_SECRET=
GOVERNANCE_OIDC_CLIENT_ID=
GOVERNANCE_OIDC_CLIENT_SECRET=

# Private institutional core
CORE_DATABASE_SCHEMA=aura_core
CORE_API_URL=http://localhost:3300
CORE_API_AUDIENCE=urn:aura:core-api
CORE_OIDC_ISSUER=http://localhost:3200/api/auth
CORE_OIDC_JWKS_URL=http://localhost:3200/api/auth/jwks
CORE_RESET_CONFIRMATION=AURA-SYNTHETIC-SEED-V1

# Optional model path. The deterministic fallback requires neither value.
AURA_MODEL_ID=openai/gpt-5.6-luna
AURA_MODEL_ENABLED=false
